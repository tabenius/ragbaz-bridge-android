<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Every receiver below acts for the phone's owner (send SMS, read contacts,
      ring the phone). They are exported only so `adb shell am broadcast` can
      reach them, and require android.permission.DUMP: the adb shell user holds
      it, ordinary installed apps cannot obtain it. Without this any app on the
      device could send SMS or dump contacts through the bridge.
    -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="Ragbaz Bridge"
        android:theme="@style/Theme.AppCompat.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".SendSmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ragbaz.bridge.SEND_SMS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ContactsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ragbaz.bridge.CONTACTS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".FindPhoneReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ragbaz.bridge.FIND_PHONE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".OshiReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ragbaz.bridge.OSHI" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
